{
  "name": "bonkosapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/catalog-keys.mjs && node scripts/releases.mjs --sample && vite",
    "build": "node scripts/catalog-keys.mjs && node scripts/releases.mjs --sample && tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
