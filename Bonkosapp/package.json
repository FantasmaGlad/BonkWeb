    "lint": "biome check .",
    "test": "node scripts/catalog-keys.mjs && node scripts/releases.mjs --sample && vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
